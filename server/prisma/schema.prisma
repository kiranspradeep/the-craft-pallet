// =============================================================================
// prisma/schema.prisma
// The Craft Pallet — Personalized Gifts & Printing Platform
// Version 7 — Order Flow v2
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum AdminRole {
  ADMIN
  SUPERADMIN
}

enum PricingStrategy {
  INCREMENTAL_QUANTITY
  FIXED_VARIANTS
  PER_UNIT
  TIERED_PRICING
  CUSTOM_QUOTE
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  RADIO
  CHECKBOX
  URL
  PHOTO_UPLOAD
}

enum AssetSourceType {
  DIRECT_UPLOAD
  ZIP_UPLOAD
  GOOGLE_DRIVE
  WHATSAPP
  ADMIN_UPLOAD
}

enum AssetStatus {
  WAITING
  UPLOADING
  UPLOADED
  PROCESSING
  FAILED
  DOWNLOADED
  VERIFIED
  REJECTED
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PhotoStatus {
  NOT_REQUIRED
  NOT_RECEIVED
  RECEIVED
  VERIFIED
}

enum OrderSource {
  WEBSITE
  WHATSAPP
}

enum CheckoutMethod {
  CART
  BUY_NOW
}

enum ProductionStage {
  QUEUED
  DESIGN
  PRINTING
  CRAFTING
  PACKING
  READY
}

enum PaymentStatus {
  PENDING
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  COD
  MANUAL
}

enum ShipmentStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
}

enum TimelineEventType {
  ORDER_PLACED
  DRAFT_CREATED
  PAYMENT_INITIATED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  ORDER_CONFIRMED
  PRODUCTION_STAGE_CHANGED
  ASSET_STATUS_CHANGED
  PHOTOS_RECEIVED
  PHOTOS_VERIFIED
  NOTE_ADDED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ActorType {
  SYSTEM
  ADMIN
  CUSTOMER
}

enum ProductImageType {
  THUMBNAIL
  GALLERY
  BANNER
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

enum JobType {
  ZIP_EXTRACTION
  IMAGE_COMPRESSION
  PREVIEW_GENERATION
  VIRUS_SCAN
  DRIVE_DOWNLOAD
}

// =============================================================================
// ADMIN AUTHENTICATION
// =============================================================================

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions AdminSession[]
  timeline OrderTimeline[]
  payments Payment[]

  @@map("admin_users")
}

model AdminSession {
  id          String   @id @default(cuid())
  adminUserId String
  token       String   @unique
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("admin_sessions")
}

// =============================================================================
// CUSTOMER
// =============================================================================

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  couponUsages CouponUsage[]

  @@map("customers")
}

// =============================================================================
// ORDER SEQUENCE
// =============================================================================

model OrderSequence {
  id         String   @id @default(cuid())
  year       Int      @unique
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("order_sequences")
}

// =============================================================================
// CATALOG
// =============================================================================

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products Product[]

  @@map("categories")
}

model Product {
  id               String    @id @default(cuid())
  categoryId       String
  name             String
  slug             String    @unique
  description      String?
  shortDescription String?
  isActive         Boolean   @default(true)
  isFeatured       Boolean   @default(false)
  sortOrder        Int       @default(0)
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  ogImageUrl       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  variants      ProductVariant[]
  pricingConfig PricingConfiguration?
  configuration ProductConfiguration?
  customFields  CustomField[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String           @id @default(cuid())
  productId String
  url       String
  altText   String?
  type      ProductImageType @default(GALLERY)
  width     Int?
  height    Int?
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  name           String
  sku            String?  @unique
  price          Decimal  @db.Decimal(10, 2)
  processingDays Int?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

   product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images     VariantImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model VariantImage {
  id        String   @id @default(cuid())
  variantId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("variant_images")
}

model ProductConfiguration {
  id                      String            @id @default(cuid())
  productId               String            @unique
  uploadRequired          Boolean           @default(false)
  minImages               Int?
  maxImages               Int?
  maxFileSizeMb           Int?
  maxZipSizeMb            Int?
  allowedExtensions       String[]
  allowedSources          AssetSourceType[]
  allowDuplicateImages    Boolean           @default(false)
  allowImageReordering    Boolean           @default(true)
  estimatedProductionDays Int?
  extraRules              Json?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_configurations")
}

model PricingConfiguration {
  id        String          @id @default(cuid())
  productId String          @unique
  strategy  PricingStrategy

  minimumOrderQuantity Int?
  incrementQuantity    Int?
  incrementPrice       Decimal? @db.Decimal(10, 2)

  unitPrice Decimal? @db.Decimal(10, 2)

  baseUnitPrice Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  tiers   PricingTier[]

  @@map("pricing_configurations")
}

model PricingTier {
  id              String   @id @default(cuid())
  pricingConfigId String
  quantity        Int
  price           Decimal  @db.Decimal(10, 2)
  label           String?
  isSpecialOffer  Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pricingConfig PricingConfiguration @relation(fields: [pricingConfigId], references: [id], onDelete: Cascade)

  @@index([pricingConfigId])
  @@map("pricing_tiers")
}

model CustomField {
  id             String          @id @default(cuid())
  productId      String
  name           String
  label          String
  type           CustomFieldType
  placeholder    String?
  helpText       String?
  isRequired     Boolean         @default(false)
  sortOrder      Int             @default(0)
  validationJson Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  options        CustomFieldOption[]
  customizations Customization[]

  @@index([productId])
  @@map("custom_fields")
}

model CustomFieldOption {
  id            String   @id @default(cuid())
  customFieldId String
  label         String
  value         String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@map("custom_field_options")
}

// =============================================================================
// SHOPPING CART
// =============================================================================

model Cart {
  id             String    @id @default(cuid())
  sessionId      String    @unique
  expiresAt      DateTime?
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id                    String   @id @default(cuid())
  cartId                String
  productId             String
  variantId             String?
  quantity              Int      @default(1)
  unitPrice             Decimal  @db.Decimal(10, 2)
  selectedTierQuantity  Int?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  cart           Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  customizations Customization[]

  @@map("cart_items")
}

// =============================================================================
// CHECKOUT SESSION (Buy Now temporary storage)
// =============================================================================

/// Temporary storage for "Buy Now" checkout flow — expires after 30 min
/// Bypasses cart, holds a single product configuration until order is placed
model CheckoutSession {
  id                    String    @id @default(cuid())
  sessionId             String
  productId             String
  variantId             String?
  quantity              Int       @default(1)
  selectedTierQuantity  Int?
  unitPrice             Decimal   @db.Decimal(10, 2)
  notes                 String?
  customizations        Json?
  assetId               String?
  expiresAt             DateTime
  createdAt             DateTime  @default(now())

  @@index([sessionId])
  @@index([expiresAt])
  @@map("checkout_sessions")
}

// =============================================================================
// CUSTOMIZATION
// =============================================================================

model Customization {
  id            String @id @default(cuid())
  customFieldId String

  cartItemId  String?
  orderItemId String?

  unitIndex    Int     @default(0)   // ← ADD THIS LINE

  fieldLabel String
  fieldType  CustomFieldType

  textValue    String?
  numberValue  Decimal?  @db.Decimal(10, 2)
  dateValue    DateTime?
  booleanValue Boolean?

  assetId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customField CustomField @relation(fields: [customFieldId], references: [id])
  cartItem    CartItem?   @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  orderItem   OrderItem?  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  asset       Asset?      @relation(fields: [assetId], references: [id])

  @@index([cartItemId])
  @@index([orderItemId])
  @@index([customFieldId])
  @@map("customizations")
}

// =============================================================================
// ASSET
// =============================================================================

model Asset {
  id                 String          @id @default(cuid())
  sourceType         AssetSourceType
  status             AssetStatus     @default(WAITING)
  externalUrl        String?
  externalRef        String?
  uploadProgress     Int?
  processingProgress Int?
  notes              String?
  reviewedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  customization  Customization?
  files          AssetFile[]
  processingJobs FileProcessingJob[]

  @@index([status])
  @@map("assets")
}

model AssetFile {
  id             String   @id @default(cuid())
  assetId        String
  originalName   String
  storedName     String
  storagePath    String
  previewPath    String?
  printReadyPath String?
  mimeType       String?
  fileSize       Int?
  checksum       String?
  width          Int?
  height         Int?
  sortOrder      Int      @default(0)
  uploadedAt     DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_files")
}

model FileProcessingJob {
  id           String    @id @default(cuid())
  assetId      String
  type         JobType
  status       JobStatus @default(QUEUED)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  progress     Int?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  nextRetryAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([status])
  @@map("file_processing_jobs")
}

// =============================================================================
// ORDERS
// =============================================================================

model Order {
  id              String           @id @default(cuid())
  orderNumber     String           @unique
  whatsappToken   String?          @unique
  customerId      String
  shipName        String
  shipPhone       String
  shipLine1       String
  shipLine2       String?
  shipCity        String
  shipState       String
  shipPincode     String
  shipCountry     String           @default("India")
  status          OrderStatus      @default(AWAITING_PAYMENT)
  photoStatus     PhotoStatus      @default(NOT_REQUIRED)
  productionStage ProductionStage?
  orderSource     OrderSource      @default(WEBSITE)
  checkoutMethod  CheckoutMethod   @default(CART)
  subtotal        Decimal          @db.Decimal(10, 2)
  discountAmount  Decimal          @default(0) @db.Decimal(10, 2)
  shippingCharge  Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal          @db.Decimal(10, 2)
  currency        String           @default("INR")
  couponCode      String?
  customerNote    String?
  adminNote       String?
  driveLink       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  customer Customer        @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  payment  Payment?
  shipment Shipment?
  timeline OrderTimeline[]

  @@index([customerId])
  @@index([status])
  @@index([photoStatus])
  @@index([orderSource])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                    String          @id @default(cuid())
  orderId               String
  productId             String
  variantId             String?
  quantity              Int
  unitPrice             Decimal         @db.Decimal(10, 2)
  totalPrice            Decimal         @db.Decimal(10, 2)
  selectedTierQuantity  Int?
  productName           String
  variantName           String?
  productDescription    String?
  variantDescription    String?
  pricingStrategy       PricingStrategy
  createdAt             DateTime        @default(now())

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  customizations Customization[]

  @@index([orderId])
  @@map("order_items")
}

// =============================================================================
// PAYMENT
// =============================================================================

model Payment {
  id               String         @id @default(cuid())
  orderId          String         @unique
  status           PaymentStatus  @default(PENDING)
  method           PaymentMethod?
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("INR")
  gatewayName      String?
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  gatewayResponse  Json?
  referenceNumber  String?
  failureReason    String?
  paidAt           DateTime?
  verifiedBy       String?
  verifiedAt       DateTime?
  refundedAt       DateTime?
  refundAmount     Decimal?       @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifiedByAdmin AdminUser? @relation(fields: [verifiedBy], references: [id])

  @@map("payments")
}

// =============================================================================
// SHIPPING
// =============================================================================

model ShippingPartner {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  trackingUrl String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  shipments Shipment[]

  @@map("shipping_partners")
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String         @unique
  shippingPartnerId String
  trackingNumber    String
  status            ShipmentStatus @default(PENDING)
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shippingPartner ShippingPartner @relation(fields: [shippingPartnerId], references: [id])

  @@map("shipments")
}

// =============================================================================
// ORDER TIMELINE
// =============================================================================

model OrderTimeline {
  id                  String            @id @default(cuid())
  orderId             String
  eventType           TimelineEventType
  title               String
  description         String?
  actorType           ActorType         @default(SYSTEM)
  actorId             String?
  isVisibleToCustomer Boolean           @default(false)
  metadata            Json?
  createdAt           DateTime          @default(now())

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminActor AdminUser? @relation(fields: [actorId], references: [id])

  @@index([orderId])
  @@index([isVisibleToCustomer])
  @@map("order_timeline")
}

// =============================================================================
// COUPONS
// =============================================================================

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  discountPercent Decimal?  @db.Decimal(5, 2)
  discountFlat    Decimal?  @db.Decimal(10, 2)
  minOrderAmount  Decimal?  @db.Decimal(10, 2)
  maxUses         Int?
  usedCount       Int       @default(0)
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  usages CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id         String   @id @default(cuid())
  couponId   String
  customerId String
  orderId    String   @unique
  usedAt     DateTime @default(now())

  coupon   Coupon   @relation(fields: [couponId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([couponId, customerId])
  @@map("coupon_usages")
}

// =============================================================================
// SETTINGS
// =============================================================================

model BusinessSetting {
  id             String   @id @default(cuid())
  businessName   String   @default("The Craft Pallet")
  tagline        String?
  email          String?
  phone          String?
  address        String?
  logoUrl        String?
  faviconUrl     String?
  instagramUrl   String?
  currency       String   @default("INR")
  minOrderAmount Decimal? @db.Decimal(10, 2)
  updatedAt      DateTime @updatedAt

  @@map("business_settings")
}

model PaymentSetting {
  id                String   @id @default(cuid())
  gatewayName       String
  isLiveMode        Boolean  @default(false)
  apiKey            String?
  apiSecret         String?
  webhookSecret     String?
  upiId             String?
  codEnabled        Boolean  @default(false)
  codMaxOrderAmount Decimal? @db.Decimal(10, 2)
  updatedAt         DateTime @updatedAt

  @@map("payment_settings")
}

model ShippingSetting {
  id                       String   @id @default(cuid())
  keralaShippingCharge     Decimal? @db.Decimal(10, 2)
  outsideKeralaShippingCharge Decimal? @db.Decimal(10, 2)
  keralaProcessingDays     Int?
  outsideKeralaProcessingDays Int?
  updatedAt                DateTime @updatedAt

  @@map("shipping_settings")
}

model WhatsAppSetting {
  id                   String   @id @default(cuid())
  phoneNumber          String?
  isEnabled            Boolean  @default(false)
  orderMessageTemplate String?
  updatedAt            DateTime @updatedAt

  @@map("whatsapp_settings")
}

model ImageRetentionSetting {
  id               String   @id @default(cuid())
  retentionDays    Int      @default(90)
  maxUploadSizeMb  Int      @default(500)
  allowedMimeTypes String[]
  storageProvider  String   @default("local")
  storageBucket    String?Z
  storageRegion    String?
  updatedAt        DateTime @updatedAt

  @@map("image_retention_settings")
}